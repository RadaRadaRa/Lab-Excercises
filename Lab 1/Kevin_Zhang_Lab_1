#when brainstorming how to create a class that manages a student's school records, I thought about what functions,
#that I as a student, would care about. I quickly figured out that my gpa and whether I'm on the dean's list is pretty important
#I created a function that would add classes and their corresponding letter grades into a dictionary. Afterwards
#I created a function that would turn the letter grades into their equivalent numerical grade. 
# Then it would calculate the gpa based on all the grades in the dictionary. 
# Afterwards I created a function that would check if the gpa was above the cut off for dean's list
#and return TRUE or FALSE accordingly. 
class student_school_record:
    def __init__(self, name, major):
        self.name=name
        self.grades={}
        self.major=major
    def add_grade(self, classname, lettergrade):
        lettergrade=lettergrade.lower()
        checklist=["a","a-","b+","b","b-","c+","c","c-","d","f"]
        if lettergrade in checklist:
            self.grades["classname"]=lettergrade
        else:
            print("Function only takes standard alphabetic grades (eg. a, a-, b+, etc).")
    def gpa(self):
        self.gpa=0
        from statistics import mean
        grade_point_equivalent=[]
        for x in self.grades.values():
            if x=="a":
                grade_point_equivalent.append(4)
            elif x=="a-":
                grade_point_equivalent.append(3.7)
            elif x=="b+":
                grade_point_equivalent.append(3.3)
            elif x=="b":
                grade_point_equivalent.append(3.0)
            elif x=="b-":
                grade_point_equivalent.append(2.7)
            elif x=="c+":
                grade_point_equivalent.append(2.3)
            elif x=="c":
                grade_point_equivalent.append(2.0)
            elif x=="c-":
                grade_point_equivalent.append(1.7)
            elif x=="d":
                grade_point_equivalent.append(1.0)
            elif x=="f":
                grade_point_equivalent.append(0.0)
        self.gpa=(mean(grade_point_equivalent))
        print(self.gpa)
    def ondeanlist(self):
        self.gpa=0
        from statistics import mean
        grade_point_equivalent=[]
        for x in self.grades.values():
            if x=="a":
                grade_point_equivalent.append(4)
            elif x=="a-":
                grade_point_equivalent.append(3.7)
            elif x=="b+":
                grade_point_equivalent.append(3.3)
            elif x=="b":
                grade_point_equivalent.append(3.0)
            elif x=="b-":
                grade_point_equivalent.append(2.7)
            elif x=="c+":
                grade_point_equivalent.append(2.3)
            elif x=="c":
                grade_point_equivalent.append(2.0)
            elif x=="c-":
                grade_point_equivalent.append(1.7)
            elif x=="d":
                grade_point_equivalent.append(1.0)
            elif x=="f":
                grade_point_equivalent.append(0.0)
        self.gpa=(mean(grade_point_equivalent))
        return (self.gpa>=3.5)
    
