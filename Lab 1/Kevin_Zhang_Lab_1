def shortest_word_in_ranlist_fun():
    length_of_words_in_list_list=[]
    ten_words_list=[]
    import random
    filename="sowpods.txt"
    f=open(filename,"r",encoding="utf8")
    words=f.readlines() 
    counter=10
    randworddict={}
    while counter >=0:
        ten_words_list.append(random.choice(words).strip())
        counter-=1
    for word in ten_words_list:
        length_of_words_in_list_list.append(len(word))
        randworddict[word]=len(word)
    print(ten_words_list[length_of_words_in_list_list.index(min(length_of_words_in_list_list))])
    print(randworddict)
shortest_word_in_ranlist_fun()

